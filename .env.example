# ── Database (Supabase Transaction Pooler) ──────────────────────────
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Optional server-only CA bundle for certificate-verified database TLS. Paste PEM contents, including BEGIN/END lines.
DATABASE_SSL_CA=

# ── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...

# ── Push notifications (Firebase Cloud Messaging HTTP v1) ───────────
# Firebase project id and the base64-encoded service-account JSON key
# (Firebase console → Project settings → Service accounts → Generate new private key,
# then: base64 -w0 service-account.json). Push is skipped when unset.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
# Shared secret for scheduled endpoints (/api/keepalive, /api/push/reminders).
# Must match the GitHub Actions CRON_SECRET secret.
CRON_SECRET=

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required server-only signing key in every environment. Generate 32 random bytes
# with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Never prefix with NEXT_PUBLIC_. Rotating this key signs everyone out.
SESSION_SECRET=

# Optional authenticated E2E and smoke coverage. Keep real values out of git.
E2E_EMAIL=
E2E_PASSWORD=
