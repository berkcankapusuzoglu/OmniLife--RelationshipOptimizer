# ── Database (Supabase Transaction Pooler) ──────────────────────────
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# ── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required server-only signing key in every environment. Generate 32 random bytes
# with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Never prefix with NEXT_PUBLIC_. Rotating this key signs everyone out.
SESSION_SECRET=

# Optional authenticated E2E and smoke coverage. Keep real values out of git.
E2E_EMAIL=
E2E_PASSWORD=
