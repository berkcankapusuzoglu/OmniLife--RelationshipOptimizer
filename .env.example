# ── Database (Supabase Transaction Pooler) ──────────────────────────
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Optional server-only CA bundle for certificate-verified database TLS. Paste PEM contents, including BEGIN/END lines.
DATABASE_SSL_CA=

# ── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Premium is the only tier sold on the web ($4.99/mo, $24.99/yr; 7-day trial for first-time customers).
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_...
# Comma-separated price ids of subscriptions created before v1.1.0. They are never sold,
# but renewals on them keep their original tier.
STRIPE_LEGACY_PREMIUM_PRICE_IDS=
STRIPE_LEGACY_PRO_PRICE_IDS=
# Pre-1.1.0 names, accepted as legacy aliases for one release:
# STRIPE_MONTHLY_PRICE_ID / STRIPE_YEARLY_PRICE_ID (Premium), STRIPE_PRO_MONTHLY_PRICE_ID / STRIPE_PRO_YEARLY_PRICE_ID (Pro)

# ── Push notifications (Firebase Cloud Messaging HTTP v1) ───────────
# Firebase project id and the base64-encoded service-account JSON key
# (Firebase console → Project settings → Service accounts → Generate new private key,
# then: base64 -w0 service-account.json). Push is skipped when unset.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
# Shared secret for scheduled endpoints (/api/keepalive, /api/push/reminders).
# Must match the GitHub Actions CRON_SECRET secret.
CRON_SECRET=

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required server-only signing key in every environment. Generate 32 random bytes
# with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Never prefix with NEXT_PUBLIC_. Rotating this key signs everyone out.
SESSION_SECRET=

# Optional authenticated E2E and smoke coverage. Keep real values out of git.
E2E_EMAIL=
E2E_PASSWORD=
