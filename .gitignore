# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tests/screenshots/
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# IDE
.idea/
.vscode/

# Claude Code
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Capacitor
ios/

# Android source is tracked; credentials and generated files are local only.
*.keystore
*.jks
*.p12
*.pfx
/android/**/local.properties
/android/**/keystore.properties
/android/**/signing.properties
/android/**/google-services.json
/android/**/.gradle/
/android/**/.kotlin/
/android/**/build/
/android/**/.cxx/
/android/**/.externalNativeBuild/
/android/**/*.iml
/android/**/*.log
/android/**/*.apk
/android/**/*.aab
/android/**/*.ap_
/android/**/*.dex
/android/**/*.class
/android/capacitor-cordova-android-plugins/
/android/capacitor.settings.gradle
/android/app/capacitor.build.gradle
/android/app/src/main/assets/*
!/android/app/src/main/assets/.gitkeep
/android/app/src/main/res/xml/config.xml

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
